<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Юқори Визуализатор ёки Видео Фон майдони -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#1A1A1A">

            <VideoView
                android:id="@+id/bgVideoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.carrozzeria.dspplayer.VisualizerView
                android:id="@+id/visualizerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Плеер ва Видео тугмалари -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnPickAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MP3 Танлаш"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Play / Pause"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPickVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Видео Фон" />
        </LinearLayout>

        <!-- Студия / Эхо тугмалари -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ЭХО / СТУДИЯ РЕЖИМИ:"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnEchoOff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ўчиқ"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnEchoStudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Студия"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnEchoClub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Клуб"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnEchoConcert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Концерт"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Пресетлар ва Сақлаш -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <Spinner
                android:id="@+id/spinnerPresets"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="#222222"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSavePreset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сақлаш (+)" />
        </LinearLayout>

        <!-- 13-полосали Pioneer Эквалайзер -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIONEER 13-ПОЛОСАЛИ ЭКВАЛАЙЗЕР (Hz):"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/eqContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

    </LinearLayout>
</ScrollView>
